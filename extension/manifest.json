{
  "manifest_version": 3,
  "name": "KSU Agent",
  "version": "0.1.0",
  "permissions": ["storage"],
  "host_permissions": [
    "https://edugate.ksu.edu.sa/*",
    "https://lms.ksu.edu.sa/*"
  ],
  "background": {
    "service_worker": "dist/background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://edugate.ksu.edu.sa/*"],
      "js": ["dist/content/edugate.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://lms.ksu.edu.sa/*"],
      "js": ["dist/content/lms.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "externally_connectable": {
    "matches": [
      "http://localhost:3000/*",
      "https://ksu-agent-web.onrender.com/*"
    ]
  },
  "key": ""
}
